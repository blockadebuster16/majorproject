# ============================================================================
# SignBridge AI - Environment Variable Configuration Template
# ============================================================================

# 1. Application & Base URLs (Render & Vercel Dynamic Hosting)
# Frontend Hosting:
# - Vercel: Set NEXT_PUBLIC_APP_URL to your Vercel URL (e.g., https://your-project.vercel.app)
#   (SignBridge will also automatically detect VERCEL_URL if unset)
# - Render: Set NEXT_PUBLIC_APP_URL to your Render Web Service URL (e.g., https://your-frontend.onrender.com)
#   (SignBridge will also automatically detect RENDER_EXTERNAL_URL if unset)
# - Local Development: Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Backend & API Hosting:
# - If running a standalone backend service on Render:
#   Set to your Render backend URL (e.g., https://your-backend.onrender.com)
# - If running a local Python / Flask / FastAPI / Node backend:
#   Set to http://localhost:5000
# - If using integrated Next.js API routes on Vercel/Render, leave blank or unset to use relative /api/v1/* routes
NEXT_PUBLIC_BACKEND_URL=
BACKEND_URL=

# 2. Supabase & PostgreSQL (Identity, Persistence & Storage)
# Required for persistent authentication, Google OAuth & RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signbridge

# 3. Google OAuth Provider (Managed via Supabase Auth or Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 4. Custom Sign Language Recognition Model Adapter
# When empty or unset, SignBridge defaults to DevSignLanguageRecognizer.
# In production on Render, point to your deployed inference cluster (e.g. https://your-model.onrender.com or http://localhost:5000)
SIGN_MODEL_ENDPOINT=
SIGN_MODEL_API_KEY=your-inference-cluster-token-optional
SIGN_MODEL_TIMEOUT_MS=15000

# 5. Audio Transcription Service
# Supported providers: 'whisper-dev', 'openai-whisper'
AUDIO_TRANSCRIPTION_PROVIDER=whisper-dev
OPENAI_API_KEY=your-openai-api-key-optional

# 6. Conversational LLM Engine
# When OPENAI_API_KEY is unset, SignBridge defaults to DevConversationalLLMProvider
LLM_PROVIDER=signbridge-dev
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# 7. Future 3D AI Avatar Integration Service Contract
# Endpoint of the independent 3D signing avatar microservice
AVATAR_SERVICE_ENDPOINT=
AVATAR_SERVICE_API_KEY=
AVATAR_CALLBACK_SECRET=

# 8. Media Upload Limits & Ephemeral Retention
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=60
MAX_AUDIO_DURATION_SECONDS=120
MEDIA_EPHEMERAL_RETENTION_HOURS=48

# 9. Observability & Error Tracking
SENTRY_DSN=
LOG_LEVEL=info
TELEMETRY_ENABLED=true
